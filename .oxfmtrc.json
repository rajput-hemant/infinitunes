{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "jsxSingleQuote": false,
  "sortImports": {
    "internalPattern": ["@/", "~/", "#"],
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": false,
  "tailwind": {
    "preserveWhitespace": false
  },
  "ignorePatterns": [
    "public",
    "node_modules",
    ".next",
    "build",
    "migrations",
    "bun.lock"
  ]
}
