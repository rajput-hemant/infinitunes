{
  "name": "infinitunes",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "bun test --pass-with-no-tests",
    "fmt": "prettier --write \"**/*.{ts,tsx,mdx,json}\" --cache",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,mdx,json}\" --cache",
    "db:generate": "bun run --filter @infinitunes/web db:generate",
    "db:migrate": "bun run --filter @infinitunes/web db:migrate",
    "db:drop": "bun run --filter @infinitunes/web db:drop",
    "db:push": "bun run --filter @infinitunes/web db:push",
    "db:pull": "bun run --filter @infinitunes/web db:pull",
    "db:studio": "bun run --filter @infinitunes/web db:studio",
    "db:check": "bun run --filter @infinitunes/web db:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": [
      "prettier --write \"**/*.{ts,tsx,mdx}\" --cache"
    ],
    "*.{ts,tsx,mdx}": [
      "eslint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
