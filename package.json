{
  "name": "infinitunes",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @infinitunes/web dev",
    "build": "bun run --filter @infinitunes/web build",
    "start": "bun run --filter @infinitunes/web start",
    "lint": "bun run --filter '*' lint",
    "type-check": "bun run --filter '*' type-check",
    "test": "bun test --pass-with-no-tests && bun run test:isolated && bun run test:dom",
    "test:isolated": "bun test --path-ignore-patterns='' ./apps/web/tests/proxy.test.ts && bun test --path-ignore-patterns='' ./apps/web/tests/security.test.ts && bun test --path-ignore-patterns='' ./packages/trpc/tests/history-router.test.ts && bun test --path-ignore-patterns='' ./packages/trpc/tests/user-router.test.ts",
    "test:dom": "cd apps/web/tests/dom && bun test",
    "fmt": "oxfmt --write \"**/*.{ts,tsx,mdx,json}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,tsx,mdx,json}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @infinitunes/db db:generate",
    "db:migrate": "bun run --filter @infinitunes/db db:migrate",
    "db:seed": "bun run --filter @infinitunes/db db:seed",
    "db:drop": "bun run --filter @infinitunes/db db:drop",
    "db:push": "bun run --filter @infinitunes/db db:push",
    "db:pull": "bun run --filter @infinitunes/db db:pull",
    "db:studio": "bun run --filter @infinitunes/db db:studio",
    "db:check": "bun run --filter @infinitunes/db db:check",
    "ui": "bunx shadcn@latest --cwd packages/ui",
    "prepare": "husky",
    "with-env": "bun --env-file=.env --env-file=.env.local"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.11.4"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@trpc/server": "^11.19.0",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "bcryptjs": "^3.0.3",
      "better-auth": "^1.7.6",
      "drizzle-orm": "^0.45.3",
      "lucide-react": "^1.48.0",
      "next-themes": "^0.4.6",
      "oxfmt": "^0.70.0",
      "oxlint": "^1.85.0",
      "server-only": "^0.0.1",
      "sonner": "^2.0.8",
      "superjson": "^2.2.6",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "zod": "^4.6.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": [
      "oxfmt --write"
    ],
    "*.{ts,tsx,mdx}": [
      "oxlint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
