{
  "name": "infinitunes",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "bun test --pass-with-no-tests",
    "fmt": "oxfmt --write \"**/*.{ts,tsx,mdx,json}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,tsx,mdx,json}\"",
    "db:generate": "bun run --filter @infinitunes/web db:generate",
    "db:migrate": "bun run --filter @infinitunes/web db:migrate",
    "db:drop": "bun run --filter @infinitunes/web db:drop",
    "db:push": "bun run --filter @infinitunes/web db:push",
    "db:pull": "bun run --filter @infinitunes/web db:pull",
    "db:studio": "bun run --filter @infinitunes/web db:studio",
    "db:check": "bun run --filter @infinitunes/web db:check",
    "ui": "bunx shadcn@latest --cwd packages/ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@trpc/react-query": "^11.18.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "superjson": "^2.2.6",
    "turbo": "^2.10.5"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": [
      "oxfmt --write"
    ],
    "*.{ts,tsx,mdx}": [
      "oxlint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0"
  }
}
