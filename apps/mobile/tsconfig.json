{
  "extends": ["@infinitunes/typescript-config/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "types": ["jest"],
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  // Expo's excludes, plus the Bun-run E2E suites (`e2e/tsconfig.json`).
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "e2e/*.e2e.ts",
    "e2e/native-stubs.ts"
  ]
}
