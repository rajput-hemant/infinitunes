# Copy to `.env.local`. Expo inlines EXPO_PUBLIC_* variables into the bundle,
# so never put a secret here.

# Origin of the web app (apps/web) that serves /api/trpc and /api/auth.
# A device or emulator cannot reach the host's `localhost`: use the machine's
# LAN address (iOS simulator: localhost works; Android emulator: 10.0.2.2).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Google sign-in (optional; the button shows when the server has Google too).
# The web client is the server's GOOGLE_CLIENT_ID: the ID token's audience.
# Android also needs an Android OAuth client (package + signing SHA-1) in the
# same Google Cloud project; iOS needs the iOS client (its URL scheme is
# derived in app.config.ts). Changing these needs a native rebuild.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# iOS builds signed by a paid Apple Developer team: `true` adds the Sign in with
# Apple and Associated Domains (passkey) capabilities, which a free Apple ID
# cannot sign. Without it iOS shows no Apple, Google or passkey button.
EXPO_PUBLIC_APPLE_PAID_TEAM=
