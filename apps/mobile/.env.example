# Copy to `.env.local`. Expo inlines EXPO_PUBLIC_* variables into the bundle,
# so never put a secret here.

# Origin of the web app (apps/web) that serves /api/trpc and /api/auth.
# A device or emulator cannot reach the host's `localhost`: use the machine's
# LAN address (iOS simulator: localhost works; Android emulator: 10.0.2.2).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
