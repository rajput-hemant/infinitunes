{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "**/*.test.ts",
