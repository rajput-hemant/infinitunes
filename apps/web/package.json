{
  "name": "@infinitunes/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "preview": "bun --bun next build && bun --bun next start",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "fmt": "oxfmt --write \"**/*.{ts,tsx,mdx,json}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,tsx,mdx,json}\"",
    "ui": "bunx shadcn",
