{
  "name": "@infinitunes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config=./src/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config=./src/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./src/drizzle.config.ts",
    "db:pull": "drizzle-kit introspect --config=./src/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./src/drizzle.config.ts",
    "db:check": "drizzle-kit check --config=./src/drizzle.config.ts"
  },
  "exports": {
    ".": "./src/db.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./db": "./src/db.ts",
    "./migrations": "./src/migrations/index.ts",
    "./backfill": "./src/backfill.ts",
    "./drizzle.config": "./src/drizzle.config.ts"
  },
  "dependencies": {
    "@infinitunes/env": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@infinitunes/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.0",
    "typescript": "^7.0.2"
  }
}
