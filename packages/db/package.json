{
  "name": "@infinitunes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx --bun drizzle-kit generate --config=./src/drizzle.config.ts",
    "db:migrate": "bun --env-file=../../.env --env-file=../../.env.local src/migrate.ts",
    "db:seed": "bun --env-file=../../.env --env-file=../../.env.local src/seed.ts",
    "db:drop": "bunx --bun drizzle-kit drop --config=./src/drizzle.config.ts",
    "db:push": "bunx --bun drizzle-kit push --config=./src/drizzle.config.ts",
    "db:pull": "bunx --bun drizzle-kit introspect --config=./src/drizzle.config.ts",
    "db:studio": "bunx --bun drizzle-kit studio --config=./src/drizzle.config.ts",
    "db:check": "bunx --bun drizzle-kit check --config=./src/drizzle.config.ts"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@infinitunes/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/db.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./migrations": "./src/migrations/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./local-guard": "./src/fixtures/local-guard.ts",
    "./env": "./src/env.ts"
  }
}
