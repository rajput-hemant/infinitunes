{
  "ignore": [".agents/**"],
  "workspaces": {
    "apps/web": {
      "entry": [
        "scripts/api-server.ts",
        "tests/cached-api-runtime.ts",
        "tests/dom/preload.ts",
        "tests/fixtures/cached-api-fetch.mjs"
      ]
    },
    "apps/mobile": {
      "entry": [
        "src/**/*.{ios,android}.{ts,tsx}",
        "src/test/**/*.{ts,tsx}",
        "metro.config.js"
      ],
      "metro": false,
      "ignoreDependencies": [
        "@babel/plugin-transform-react-jsx",
        "expo-updates",
        "react-native-css-interop"
      ]
    },
    "packages/db": {
      "ignore": ["src/drizzle.config.ts"]
    },
    "packages/ui": {
      "ignoreDependencies": ["@shadcn/lint"]
    },
    "packages/typescript-config": {
      "ignoreUnresolved": ["next"]
    },
    "packages/core": {
      "entry": ["tests/dom/preload.ts"]
    },
    "packages/*": {}
  }
}
