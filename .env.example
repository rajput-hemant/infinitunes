# Database
# PostgreSQL connection string (required).
DATABASE_URL=

# Auth
# Public origin of the web app for Better Auth (falls back to the Vercel URL).
AUTH_URL=
# Better Auth session secret (required in production). BETTER_AUTH_SECRET takes precedence if set.
AUTH_SECRET=
# Optional alias of AUTH_URL; takes precedence over it when set.
BETTER_AUTH_URL=
# Optional alias of AUTH_SECRET; takes precedence over it when set.
BETTER_AUTH_SECRET=
# Optional passkey relying-party ID (defaults to the hostname of the app URL).
BETTER_AUTH_RP_ID=

# Google
# OAuth client ID and secret for Google sign-in (required in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
# OAuth client ID and secret for GitHub sign-in (required in production).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
# Resend API key and verified sender for password-reset email.
RESEND_API_KEY=
EMAIL_FROM=

# Playback
# DES key used to decrypt JioSaavn media URLs (required for playback).
JIOSAAVN_DES_KEY=

# Web
# Public URL of the app (optional, defaults to the production URL).
NEXT_PUBLIC_APP_URL=
# Umami analytics website ID (optional).
UMAMI_WEBSITE_ID=
# Build-only escape hatch that skips env validation; leave empty.
SKIP_ENV_VALIDATION=

# Rate limiting
# Enable the limiter (true/false, default false). Needs the Upstash values below when true.
ENABLE_RATE_LIMITING=
# Who may set client IP headers: vercel, true or false (default: vercel on Vercel, else false).
TRUSTED_PROXY=
# Requests per second allowed by the limiter (default 50).
RATE_LIMITING_REQUESTS_PER_SECOND=

# Redis
# Upstash Redis REST endpoint and token, used by the rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
