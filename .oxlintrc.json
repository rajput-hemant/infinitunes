{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "react-in-jsx-scope": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    ".turbo",
    "migrations",
    "**/*.config.js",
    "**/*.config.ts",
    "drizzle.config.ts",
    "next-env.d.ts"
  ]
}
